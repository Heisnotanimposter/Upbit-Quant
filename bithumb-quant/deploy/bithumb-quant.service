[Unit]
Description=Bithumb Quant Trading Engine (24/7 Service)
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/bithumb-quant
ExecStart=/opt/bithumb-quant/venv/bin/python main.py
Restart=always
RestartSec=10
EnvironmentFile=/opt/bithumb-quant/.env
StandardOutput=append:/opt/bithumb-quant/logs/systemd_out.log
StandardError=append:/opt/bithumb-quant/logs/systemd_err.log

[Install]
WantedBy=multi-user.target
