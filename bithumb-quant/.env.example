# Bithumb API Credentials (v2 JWT Auth)
# Generate from: Bithumb > API Management (Grant: Order, Query. DO NOT grant Withdraw!)
BITHUMB_ACCESS_KEY=your_bithumb_access_key_here
BITHUMB_SECRET_KEY=your_bithumb_secret_key_here

# Google AI Studio API Key (Gemini 2.5/1.5 Flash & Pro)
# Get from: https://aistudio.google.com/
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Telegram Bot (Remote Cockpit & Instant Push Alerts)
# Create bot via @BotFather, get ID via @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Trading Mode
# Set to 'true' for Paper Trading / Simulation (No real orders placed)
# Set to 'false' for LIVE REAL MONEY TRADING
DRY_RUN=true

# Database Path
DB_PATH=bithumb_quant.db

# Log Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
